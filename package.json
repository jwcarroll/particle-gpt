{
  "name": "particle-gpt",
  "private": true,
  "version": "2.2.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts",
    "preview": "vite preview",
    "vite": "vite"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tweakpane/core": "^2.0.4",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^4.2.0"
  },
  "dependencies": {
    "@tweakpane/plugin-essentials": "^0.2.1",
    "tweakpane": "^4.0.4"
  }
}
